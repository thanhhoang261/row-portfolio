# Copy to .env on the server (docker compose reads it) and fill in.
DOMAIN=example.com

# Keystatic (web editor at /keystatic) — GitHub mode
NEXT_PUBLIC_KEYSTATIC_STORAGE=github
NEXT_PUBLIC_KEYSTATIC_REPO=marcusrow/row-portfolio
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
# Any long random string:  openssl rand -hex 32
KEYSTATIC_SECRET=
